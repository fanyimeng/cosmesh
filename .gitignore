# Public source boundary: opt in new top-level entries explicitly.
/*
!/.gitignore
!/README.md
!/README.zh-CN.md
!/CHANGELOG.md
!/LICENSE
!/LICENSE.*
!/pyproject.toml
!/requirements-release.txt
!/cosmesh/
!/tests/
!/tools/
!/examples/
!/demos/
!/docs/
!/.github/

# Internal planning, deployment evidence and local-only tooling stay private.
/docs/*
!/docs/quickstart.md
!/docs/architecture.md
/tools/inspect_hub.py
/tools/preview_connection.py
AGENTS.md
AGENTS.local.md
.agents/
.codex/
.aws/
.ssh/

# Python, build output and editor caches.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store
.idea/
.vscode/

# Runtime state, credentials and local data.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
credentials*.json
.cosmesh/
*.log
*.sqlite*
*.db
*.sock
*.lock
*.bak
*.zip
*.tar.gz
